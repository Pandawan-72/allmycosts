{"dependencies":[],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"default\", {\n    enumerable: true,\n    get: function () {\n      return _default;\n    }\n  });\n  const LEGAL_IT = {\n    lastUpdated: \"Ultimo aggiornamento: 15 giugno 2025\",\n    editor: \"Retro-Spare\",\n    contact: \"contact@retro-spare.fr\",\n    country: \"Francia\",\n    openMailto: \"Contattaci via e-mail\",\n    aboutSection: \"INFORMAZIONI\",\n    privacyTitle: \"Informativa sulla privacy\",\n    termsTitle: \"Termini e Condizioni\",\n    privacy: {\n      intro: \"Questa informativa descrive come Retro-Spare raccoglie, utilizza e protegge i tuoi dati nell'applicazione All My Costs.\",\n      sections: [{\n        title: \"1. Editore e titolare del trattamento\",\n        body: \"L'applicazione All My Costs è edita da Retro-Spare, con sede in Francia. Per qualsiasi domanda relativa alla presente informativa, puoi contattarci all'indirizzo: contact@retro-spare.fr.\"\n      }, {\n        title: \"2. Dati raccolti\",\n        body: \"Quando crei un account, raccogliamo il tuo indirizzo e-mail, il tuo nome e una password sottoposta a hashing (bcrypt). Se accedi con Google, otteniamo la tua e-mail e il tuo nome dal profilo Google. Non sono richiesti altri dati personali.\"\n      }, {\n        title: \"3. I tuoi abbonamenti restano sul tuo dispositivo\",\n        body: \"Tutti i dati relativi ai tuoi abbonamenti (nomi, importi, categorie, date) sono memorizzati unicamente e localmente sul tuo dispositivo. Non vengono mai inviati ai nostri server né condivisi con terzi.\"\n      }, {\n        title: \"4. Utilizzo dei tuoi dati\",\n        body: \"Utilizziamo i tuoi dati solo per: creare e proteggere il tuo account, gestire il tuo stato Pro e rispondere alle richieste di assistenza. Non eseguiamo profilazione pubblicitaria e non vendiamo i tuoi dati.\"\n      }, {\n        title: \"5. Servizi di terze parti\",\n        body: \"All My Costs utilizza: Google Sign-In (autenticazione), RevenueCat (gestione degli abbonamenti Pro), Apple App Store e Google Play (pagamenti), open.er-api.com (tassi di cambio). Ogni fornitore dispone di una propria informativa.\"\n      }, {\n        title: \"6. Conservazione dei dati\",\n        body: \"I dati del tuo account sono conservati finché l'account è attivo. Puoi richiedere in qualsiasi momento la cancellazione completa del tuo account e dei dati associati scrivendo a contact@retro-spare.fr.\"\n      }, {\n        title: \"7. I tuoi diritti (GDPR)\",\n        body: \"Ai sensi del GDPR, hai diritto di accesso, rettifica, cancellazione, portabilità e opposizione riguardo ai tuoi dati personali. Puoi inoltre presentare reclamo all'autorità garante competente.\"\n      }, {\n        title: \"8. Sicurezza\",\n        body: \"Le password vengono sottoposte a hashing con bcrypt prima dell'archiviazione. Tutte le comunicazioni con i nostri server sono cifrate tramite HTTPS/TLS.\"\n      }, {\n        title: \"9. Minori\",\n        body: \"All My Costs non è destinata a persone di età inferiore a 16 anni. Se sei genitore di un minore che ha creato un account, contattaci per eliminarlo.\"\n      }, {\n        title: \"10. Modifiche\",\n        body: \"La presente informativa può essere aggiornata. Le modifiche sostanziali saranno comunicate all'interno dell'applicazione prima della loro entrata in vigore.\"\n      }, {\n        title: \"11. Contatti\",\n        body: \"Per qualsiasi domanda sui tuoi dati personali, scrivi a: contact@retro-spare.fr.\"\n      }]\n    },\n    terms: {\n      intro: \"I presenti Termini e Condizioni disciplinano l'utilizzo dell'applicazione All My Costs edita da Retro-Spare.\",\n      sections: [{\n        title: \"1. Accettazione\",\n        body: \"Scaricando, installando o utilizzando l'applicazione All My Costs («l'Applicazione»), accetti integralmente i presenti Termini. Se non accetti, non utilizzare l'Applicazione.\"\n      }, {\n        title: \"2. Descrizione del servizio\",\n        body: \"All My Costs consente agli utenti di tenere traccia dei propri abbonamenti personali, calcolare i costi mensili e annuali, esportare i dati in PDF e consultare statistiche. I dati degli abbonamenti sono memorizzati localmente sul tuo dispositivo.\"\n      }, {\n        title: \"3. Creazione dell'account\",\n        body: \"L'utilizzo dell'Applicazione richiede la creazione di un account con un indirizzo e-mail valido o tramite Google. Sei responsabile della riservatezza delle tue credenziali e di qualsiasi attività svolta dal tuo account.\"\n      }, {\n        title: \"4. Abbonamento Pro\",\n        body: \"Alcune funzionalità avanzate (statistiche dettagliate, esportazione PDF, abbonamenti illimitati) richiedono un abbonamento Pro a pagamento. Tariffe: 2,99 €/mese, 1,99 €/mese con piano annuale, o 69 € come acquisto unico a vita. Alla creazione dell'account viene offerta una prova gratuita di 48 ore.\"\n      }, {\n        title: \"5. Pagamento e fatturazione\",\n        body: \"Gli abbonamenti Pro sono fatturati tramite Apple App Store (iOS) o Google Play (Android). Il pagamento viene addebitato sul tuo account App Store o Google Play. Gli abbonamenti si rinnovano automaticamente salvo disattivazione almeno 24 ore prima della fine del periodo in corso.\"\n      }, {\n        title: \"6. Annullamento\",\n        body: \"Puoi annullare l'abbonamento in qualsiasi momento dalle impostazioni del tuo account Apple o Google. L'annullamento ha effetto al termine del periodo in corso, senza rimborso proporzionale.\"\n      }, {\n        title: \"7. Rimborsi e diritto di recesso\",\n        body: \"I rimborsi sono gestiti direttamente da Apple o Google secondo le rispettive politiche. Ai sensi dell'articolo L221-28 del Codice del consumo francese, il diritto di recesso di 14 giorni non si applica ai contenuti digitali forniti senza supporto materiale la cui esecuzione è iniziata con il consenso espresso del consumatore.\"\n      }, {\n        title: \"8. Uso accettabile\",\n        body: \"Ti impegni a utilizzare l'Applicazione nel rispetto della legge. È vietato: (a) aggirare le misure tecniche di protezione, (b) effettuare reverse engineering, (c) utilizzare l'Applicazione per scopi illegali o per danneggiare terzi.\"\n      }, {\n        title: \"9. Proprietà intellettuale\",\n        body: \"L'Applicazione, il codice, il design, i loghi e i marchi sono proprietà esclusiva di Retro-Spare. Non viene concessa alcuna licenza oltre al diritto di uso personale e non commerciale dell'Applicazione.\"\n      }, {\n        title: \"10. Limitazione di responsabilità\",\n        body: \"L'Applicazione è fornita «così com'è». Retro-Spare non può essere ritenuta responsabile per la perdita di dati locali (i tuoi abbonamenti sono memorizzati sul tuo dispositivo e il backup è di tua responsabilità), per l'accuratezza dei tassi di cambio visualizzati né per eventuali danni indiretti derivanti dall'uso dell'Applicazione.\"\n      }, {\n        title: \"11. Modifiche dei Termini\",\n        body: \"Retro-Spare si riserva il diritto di modificare i presenti Termini in qualsiasi momento. Eventuali modifiche sostanziali saranno comunicate all'interno dell'Applicazione.\"\n      }, {\n        title: \"12. Risoluzione\",\n        body: \"Puoi eliminare il tuo account in qualsiasi momento. Retro-Spare si riserva il diritto di sospendere o risolvere un account in caso di violazione dei presenti Termini.\"\n      }, {\n        title: \"13. Legge applicabile\",\n        body: \"I presenti Termini sono disciplinati dalla legge francese. Qualsiasi controversia sarà di competenza dei tribunali francesi, salvo diversa disposizione imperativa di ordine pubblico.\"\n      }, {\n        title: \"14. Contatti\",\n        body: \"Per qualsiasi domanda, contatta: contact@retro-spare.fr.\"\n      }]\n    }\n  };\n  var _default = LEGAL_IT;\n});","lineCount":107,"map":[[7,2,46,0,"Object"],[7,8,46,0],[7,9,46,0,"defineProperty"],[7,23,46,0],[7,24,46,0,"exports"],[7,31,46,0],[8,4,46,0,"enumerable"],[8,14,46,0],[9,4,46,0,"get"],[9,7,46,0],[9,18,46,0,"get"],[9,19,46,0],[10,6,46,0],[10,13,46,0,"_default"],[10,21,46,0],[11,4,46,0],[12,2,46,0],[13,2,1,0],[13,8,1,6,"LEGAL_IT"],[13,16,1,14],[13,19,1,17],[14,4,2,2,"lastUpdated"],[14,15,2,13],[14,17,2,15],[14,55,2,53],[15,4,3,2,"editor"],[15,10,3,8],[15,12,3,10],[15,25,3,23],[16,4,4,2,"contact"],[16,11,4,9],[16,13,4,11],[16,37,4,35],[17,4,5,2,"country"],[17,11,5,9],[17,13,5,11],[17,22,5,20],[18,4,6,2,"openMailto"],[18,14,6,12],[18,16,6,14],[18,39,6,37],[19,4,7,2,"aboutSection"],[19,16,7,14],[19,18,7,16],[19,32,7,30],[20,4,8,2,"privacyTitle"],[20,16,8,14],[20,18,8,16],[20,45,8,43],[21,4,9,2,"termsTitle"],[21,14,9,12],[21,16,9,14],[21,38,9,36],[22,4,10,2,"privacy"],[22,11,10,9],[22,13,10,11],[23,6,11,4,"intro"],[23,11,11,9],[23,13,11,11],[23,134,11,132],[24,6,12,4,"sections"],[24,14,12,12],[24,16,12,14],[24,17,13,6],[25,8,13,8,"title"],[25,13,13,13],[25,15,13,15],[25,54,13,54],[26,8,13,56,"body"],[26,12,13,60],[26,14,13,62],[27,6,13,251],[27,7,13,252],[27,9,14,6],[28,8,14,8,"title"],[28,13,14,13],[28,15,14,15],[28,33,14,33],[29,8,14,35,"body"],[29,12,14,39],[29,14,14,41],[30,6,14,283],[30,7,14,284],[30,9,15,6],[31,8,15,8,"title"],[31,13,15,13],[31,15,15,15],[31,66,15,66],[32,8,15,68,"body"],[32,12,15,72],[32,14,15,74],[33,6,15,278],[33,7,15,279],[33,9,16,6],[34,8,16,8,"title"],[34,13,16,13],[34,15,16,15],[34,42,16,42],[35,8,16,44,"body"],[35,12,16,48],[35,14,16,50],[36,6,16,259],[36,7,16,260],[36,9,17,6],[37,8,17,8,"title"],[37,13,17,13],[37,15,17,15],[37,42,17,42],[38,8,17,44,"body"],[38,12,17,48],[38,14,17,50],[39,6,17,282],[39,7,17,283],[39,9,18,6],[40,8,18,8,"title"],[40,13,18,13],[40,15,18,15],[40,42,18,42],[41,8,18,44,"body"],[41,12,18,48],[41,14,18,50],[42,6,18,254],[42,7,18,